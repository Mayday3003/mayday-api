# Configuración del Entorno de Ejecución - Backend Mayday API

# Puerto de escucha del servidor Express
PORT=4000

# Cadena de conexión a base de datos PostgreSQL con Pooler (para consultas normales)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Conexión directa a PostgreSQL (utilizada por Prisma para migraciones)
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Secreto de firma criptográfica para tokens JWT (generar una cadena aleatoria segura)
JWT_SECRET="tu_secreto_jwt_super_seguro_y_largo_aqui_para_produccion"

# Tiempo de expiración del token JWT
JWT_EXPIRES_IN="7d"

# URL de origen permitida para CORS (apuntar a Vercel en producción y a localhost:3000 en desarrollo)
# URL del frontend: se usa en el enlace de restablecer contraseña y se permite en CORS
FRONTEND_URL="http://localhost:3000"
# Orígenes extra para CORS, separados por coma (mayday3003.world y www ya van fijos)
CORS_ORIGINS=""

# Clave de API de Resend para correos electrónicos transaccionales
RESEND_API_KEY="re_tu_api_key_de_resend_aqui"

# Supabase Storage (subida de imágenes). La service_role key es secreta: solo en el backend
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key"
SUPABASE_BUCKET="experiencias"
